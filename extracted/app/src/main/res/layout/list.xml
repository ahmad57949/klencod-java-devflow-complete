<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="8dp"
	android:layoutDirection="rtl"
	android:background="#F5F7FB">
	<androidx.cardview.widget.CardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="#FFFFFF"
		app:cardCornerRadius="26dp"
		app:cardElevation="0dp"
		app:cardUseCompatPadding="false">
		<LinearLayout
			android:id="@+id/click"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="5dp"
			android:background="#FFFFFF"
			android:orientation="vertical">
			<RelativeLayout
				android:id="@+id/relativelayout2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="5dp">
				<LinearLayout
					android:id="@+id/linear21"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="right"
					android:orientation="vertical"
					android:layout_marginEnd="12dp"
					android:layout_toStartOf="@id/status"
					android:layout_alignParentEnd="true">
					<TextView
						android:id="@+id/textview_date"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="دربه شتيم ١٢"
						android:textSize="18sp"
						android:textStyle="bold"
						android:textColor="#202B3A"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview30"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="مواد إنشائية"
						android:textSize="13sp"
						android:textColor="#BDBDBD"
						android:focusable="false" />
				</LinearLayout>
				<TextView
					android:id="@+id/status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="5dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="متوفر"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="#16845C"
					android:paddingStart="17dp"
					android:paddingEnd="17dp"
					android:focusable="false"
					android:layout_alignParentStart="true"
					android:layout_centerVertical="true" />
			</RelativeLayout>
			<LinearLayout
				android:id="@+id/linear11"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="15dp"
				android:gravity="right|center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:gravity="end">
					<TextView
						android:id="@+id/textview8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="إجمالي قيمة المخزون"
						android:textSize="14sp"
						android:textColor="#96A3B2"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="228,000,000 د.ع"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#344255"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="100dp"
					android:gravity="right"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="الكمية الحالية"
						android:textSize="14sp"
						android:textColor="#96A3B2"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview_n"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="5dp"
						android:text="240 طن"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#124C7E"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear14"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="right|center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear16"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:gravity="end">
					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="سعر البيع"
						android:textSize="14sp"
						android:textColor="#96A3B2"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview_timer"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="950,000 د.ع"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#344255"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear15"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="100dp"
					android:gravity="right"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview9"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="سعر الشراء"
						android:textSize="14sp"
						android:textColor="#96A3B2"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview5"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="850,000 د.ع"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="#344255"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear17"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:padding="5dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/delete"
					android:layout_width="100dp"
					android:layout_height="40dp"
					android:background="#FFF0F2"
					android:gravity="center_horizontal|center_vertical"
					android:text="▤  حذف"
					android:textSize="17sp"
					android:textStyle="bold"
					android:textColor="#D13D58"
					android:focusable="true" />
				<View
					android:id="@+id/view18"
					android:layout_width="0dp"
					android:layout_height="1dp"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/edit"
					android:layout_width="100dp"
					android:layout_height="40dp"
					android:background="#FFFFFF"
					android:gravity="center_horizontal|center_vertical"
					android:text="✎  تعديل"
					android:textSize="17sp"
					android:textStyle="bold"
					android:textColor="#124C7E"
					android:focusable="true" />
			</LinearLayout>
		</LinearLayout>
	</androidx.cardview.widget.CardView>
</LinearLayout>
