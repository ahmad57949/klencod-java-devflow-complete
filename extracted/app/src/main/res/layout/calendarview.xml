<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/ll_root"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:layout_gravity="center_horizontal|center_vertical"
		android:animateLayoutChanges="true">
		<LinearLayout
			android:id="@+id/ll_calendar_head"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="#FFFFFF"
			android:orientation="horizontal"
			android:animateLayoutChanges="true">
			<ImageView
				android:id="@+id/previous_month"
				android:focusable="false"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:src="@drawable/default_image"
				android:scaleType="fitCenter"
				android:layout_gravity="right" />
			<TextView
				android:id="@+id/display_current_date"
				android:focusable="false"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:text="CurDate"
				android:textSize="11sp"
				android:textStyle="bold"
				android:textColor="#000000"
				android:layout_gravity="center_horizontal|center_vertical"
				android:layout_weight="3" />
			<ImageView
				android:id="@+id/next_month"
				android:focusable="false"
				android:layout_width="30dp"
				android:layout_height="30dp"
				android:src="@drawable/default_image"
				android:scaleType="fitCenter"
				android:layout_gravity="right" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/ll_calendar_week"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="#FFFFFF"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/sun"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="السبت"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/mon"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الاحد"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/tue"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الاثنين"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/wed"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الثلاثاء"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/thu"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الاربعاء"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/fri"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الخميس"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/sat"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="3dp"
				android:paddingRight="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الجمعه"
				android:textSize="10sp"
				android:textStyle="bold"
				android:textColor="#03A9F4"
				android:layout_weight="1" />
		</LinearLayout>
		<GridView
			android:id="@+id/calendar_grid"
			android:layout_width="match_parent"
			android:layout_height="135dp"
			tools:animateLayoutChanges="false"
			android:animateLayoutChanges="false"
			android:numColumns="7"
			tools:listitem="@layout/calendarview_cell" />
	</LinearLayout>
</LinearLayout>
