<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="6dp"
	android:background="@android:color/transparent">
	<androidx.cardview.widget.CardView
		android:id="@+id/cardview1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:contentPadding="8dp"
		app:cardBackgroundColor="#FFFFFF"
		app:cardElevation="0dp"
		app:cardCornerRadius="20dp">
		<LinearLayout
			android:id="@+id/linear_notes_list"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear38"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical|end">
				<TextView
					android:id="@+id/textview29"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="جدول العمل"
					android:textSize="13sp"
					android:textStyle="bold"
					android:textColor="#202124" />
				<ImageView
					android:id="@+id/imageview22"
					android:focusable="false"
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/icon_event_note_twotone"
					android:scaleType="fitCenter"
					android:layout_marginStart="6dp" />
			</LinearLayout>
			<View
				android:id="@+id/linear37"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginTop="8dp"
				android:background="#E9EDF2" />
			<TextView
				android:id="@+id/textview24"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="32dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="اليوم                         الوقت"
				android:textSize="11sp"
				android:textStyle="bold"
				android:textColor="#0D467D" />
			<View
				android:id="@+id/view30"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview28"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="السبت       ٧:٠٠ - ٧:٠٠"
				android:textSize="11sp"
				android:textColor="#555555" />
			<View
				android:id="@+id/view4"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview31"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الأحد       ٧:٠٠ - ٧:٠٠"
				android:textSize="11sp"
				android:textColor="#555555" />
			<View
				android:id="@+id/view32"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview33"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الاثنين       ٧:٠٠ - ٧:٠٠"
				android:textSize="11sp"
				android:textColor="#555555" />
			<View
				android:id="@+id/view36"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview57"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الثلاثاء       ٧:٠٠ - ٧:٠٠"
				android:textSize="11sp"
				android:textColor="#555555" />
			<View
				android:id="@+id/linear39"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview58"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الأربعاء       ٧:٠٠ - ٧:٠٠"
				android:textSize="11sp"
				android:textColor="#555555" />
			<View
				android:id="@+id/linear40"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview59"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الخميس       ٧:٠٠ - ٧:٠٠"
				android:textSize="11sp"
				android:textColor="#555555" />
			<View
				android:id="@+id/linear42"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="#EEEEEE" />
			<TextView
				android:id="@+id/textview60"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="30dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="الجمعة       اجازه"
				android:textSize="11sp"
				android:textColor="#555555" />
		</LinearLayout>
	</androidx.cardview.widget.CardView>
</LinearLayout>
